# 1. Regenerate training data (new prompt suite + temperatures)
llm-fingerprinter simulate -b <backend> -m <model> --family <family> --num-sims 5
# repeat for each family

# 2. Train
llm-fingerprinter train --cross-validate

# 3. Build templates (both levels)
llm-fingerprinter build-templates
llm-fingerprinter build-model-templates

# 4. Verify everything looks right
llm-fingerprinter info
llm-fingerprinter list-fingerprints

# 5. Test identification
llm-fingerprinter identify -b <backend> --model <model>

# 6. (Optional) Benchmark strategies
python3 benchmark.py -b <backend> --models model1=family1 model2=family2

# 7. (Optional) Find weak prompts
python3 analyze_prompts.py -b <backend> --models model1=family1 model2=family2